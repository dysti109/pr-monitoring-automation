{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["company", "searched", "note", "articles"],
  "properties": {
    "company": { "type": "string" },
    "searched": { "type": "boolean" },
    "note": { "type": "string" },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["collectionGroup", "company", "publisher", "title", "reporter", "reporterContact", "publishedAt", "url", "summary", "keywords", "issueKey", "topicKey", "contentAccess", "isPrimarySource", "uniqueInformation", "sourceCategory", "source_type", "sourceReliability", "channel", "tone", "keyMessage", "differentiation", "policyTrend", "threatSignal", "actionPoint", "importance", "importanceReason", "threat", "threatReason", "subjectRelation", "reputationRisk", "reputationRiskReason", "toneReason"],
        "properties": {
          "collectionGroup": { "type": "string", "enum": ["A", "B", "C"], "description": "PR 수집 분류. A 주 대상·브랜드, B 로컬 설정의 지정 대상, C 사업이 겹치는 유사기업. 중복 해당 시 A>B>C 우선." }, "company": { "type": "string" }, "publisher": { "type": "string" }, "title": { "type": "string" }, "reporter": { "type": "string" }, "reporterContact": { "type": "string", "description": "기자에게 직접 연결되는 연락처가 기사에 공개된 경우에만 원문 그대로. 없으면 빈 문자열. 추정·생성 금지." }, "publishedAt": { "type": "string" }, "url": { "type": "string" }, "summary": { "type": "string" }, "keywords": { "type": "array", "minItems": 0, "maxItems": 5, "items": { "type": "string" } }, "issueKey": { "type": "string" }, "topicKey": { "type": "string" }, "contentAccess": { "type": "string", "enum": ["원문 전체 확인", "일부 본문 확인", "제목·공개 정보만 확인", "공식 자료 확인"] }, "isPrimarySource": { "type": "boolean" }, "uniqueInformation": { "type": "string" }, "sourceCategory": { "type": "string", "enum": ["언론 보도", "공식기관 게시물", "블로그", "커뮤니티", "SNS·영상"] }, "source_type": { "type": "string", "enum": ["official_blog", "other"], "description": "official_blog는 주 대상의 직접 운영 블로그에만 사용. 그 외 모든 출처는 other." }, "sourceReliability": { "type": "string", "enum": ["높음", "중간", "낮음", "확인 필요"] }, "channel": { "type": "string" },
          "tone": { "type": "string", "enum": ["우호", "중립", "비판", "판단 보류"] }, "keyMessage": { "type": "string" }, "differentiation": { "type": "string" }, "policyTrend": { "type": "string" }, "threatSignal": { "type": "string" }, "actionPoint": { "type": "string" },
          "importance": { "type": "string", "enum": ["높음", "중간", "낮음", "판단 보류"] }, "importanceReason": { "type": "string" }, "threat": { "type": "string", "enum": ["높음", "중간", "낮음", "판단 보류"] }, "threatReason": { "type": "string" },
          "subjectRelation": { "type": "string", "enum": ["자사 공식 발신", "고객·기관 도입/협력", "주 대상에 대한 외부 언급", "브랜드·서비스 관련 언급", "경쟁사·시장 참고"] },
          "reputationRisk": { "type": "string", "enum": ["높음", "중간", "낮음", "해당 없음"] },
          "reputationRiskReason": { "type": "string" },
          "toneReason": { "type": "string" }
        }
      }
    }
  }
}
